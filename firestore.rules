rules_version = '2';
// Regras de segurança da Comunidade da Ficha Cyberpunk RED.
// O servidor (Firebase) confere tudo isto: o site sozinho não consegue passar por cima.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function eu() { return request.auth.uid; }
    function sessDoc(gm, sid) { return /databases/$(database)/documents/mestres/$(gm)/sessoes/$(sid); }
    function gmDe(sid) { return get(/databases/$(database)/documents/sessoes/$(sid)).data.gm; }

    // Quem pode ver o conteúdo de uma sessão: o mestre dela, quem ele aprovou,
    // ou (na entrada direta) quem pediu com um código válido e não foi removido.
    function liberado(gm, sid) {
      let s = get(sessDoc(gm, sid)).data;
      let mPath = /databases/$(database)/documents/mestres/$(gm)/sessoes/$(sid)/membros/$(eu());
      let pPath = /databases/$(database)/documents/mestres/$(gm)/sessoes/$(sid)/pedidos/$(eu());
      let estado = exists(mPath) ? get(mPath).data.estado : 'nenhum';
      return logado() && (eu() == gm || (
        s.get('encerrada', false) != true && (
          estado == 'aprovado' || (
            estado == 'nenhum' && s.get('aprovacao', '') == 'automatica' && exists(pPath)
            && get(pPath).data.get('cancelado', false) != true
            && get(pPath).data.get('codigo', '') in s.get('codigosAceitos', [])))));
    }
    function membroSala(sid) { return logado() && exists(/databases/$(database)/documents/sessoes/$(sid)) && liberado(gmDe(sid), sid); }
    function gmSala(sid) { return logado() && exists(/databases/$(database)/documents/sessoes/$(sid)) && gmDe(sid) == eu() && mestreOk(); }
    // quem digitou a senha do mestre (o documento só é criado com a senha certa, ver /chaves)
    function mestreOk() { return logado() && exists(/databases/$(database)/documents/chaves/$(eu())); }
    function autorNovo() { return request.resource.data.autor == eu(); }
    function autorAtual() { return resource.data.autor == eu(); }

    // ----- contas -----
    match /usuarios/{uid} {
      allow get: if logado();
      allow write: if logado() && uid == eu() && request.resource.data.nome is string && request.resource.data.nome.size() <= 80;
    }
    match /perfis/{uid} {
      allow read: if logado();
      allow write: if logado() && uid == eu();
    }
    // lista particular de sessões que o player pediu pra entrar
    match /pedidos/{uid} {
      allow read, write: if logado() && uid == eu();
    }
    // imagens enviadas pelo mestre
    match /assets/{id} {
      allow get: if logado();
      allow create: if logado() && request.resource.data.dono == eu() && request.resource.data.url is string && request.resource.data.url.size() < 1000000;
      allow delete: if logado() && resource.data.dono == eu();
    }
    // senha do mestre: o servidor só aceita gravar se o hash da senha bater. A senha não fica escrita aqui.
    match /chaves/{uid} {
      allow get: if logado() && uid == eu();
      allow create, update: if logado() && uid == eu()
        && request.resource.data.keys().hasOnly(['senha', 'ts'])
        && request.resource.data.senha is string && request.resource.data.senha.size() < 200
        && hashing.sha256(request.resource.data.senha).toHexString().lower() == '83cf8b609de60036a8277bd0e96135751bbc07eb234256d4b65b893360651bf2';
    }
    // tudo que é particular de cada pessoa (rascunhos do mestre, o que já viu)
    match /data/users/{uid}/{resto=**} {
      allow read, write: if logado() && uid == eu();
    }

    // ----- códigos de convite: só dá pra abrir sabendo o código (não dá pra listar) -----
    match /convites/{codigo} {
      allow get: if logado();
      allow create: if mestreOk() && request.resource.data.gm == eu() && codigo.matches('^[A-Z0-9]{4}-[A-Z0-9]{4}$');
      allow update, delete: if logado() && resource.data.gm == eu();
    }

    // ----- sessões: só o mestre dono cria, edita e administra -----
    match /mestres/{gm}/sessoes/{sid} {
      allow get: if logado();
      allow list: if logado() && gm == eu();
      allow write: if mestreOk() && gm == eu() && (request.resource == null || request.resource.data.gm == eu());

      match /membros/{uid} {
        allow read: if logado();
        allow write: if mestreOk() && gm == eu();
      }
      // cópia do pedido de entrada: o próprio player grava; o mestre lê
      match /pedidos/{uid} {
        allow read: if logado();
        allow write: if logado() && uid == eu() && uid != gm;
      }
      // mapa, locais, NPCs, pistas, missões, reputação: o mestre escreve, a mesa lê
      match /{col}/{id} {
        allow read: if liberado(gm, sid);
        allow write: if mestreOk() && gm == eu();
      }
    }
    // marca de qual mestre é cada sessão (usada nas conferências acima)
    match /sessoes/{sid} {
      allow get: if logado();
      allow create: if mestreOk() && request.resource.data.gm == eu() && exists(sessDoc(eu(), sid));
      allow update, delete: if logado() && resource.data.gm == eu();

      // ----- o que a mesa escreve dentro da sala -----
      match /mural/{id} {
        allow read: if membroSala(sid);
        // só o mestre posta como mestre ou como NPC
        allow create: if membroSala(sid) && autorNovo()
          && (gmSala(sid) || (request.resource.data.get('mestre', null) == null && request.resource.data.get('npc', null) == null));
        // reagir: só muda a própria reação
        allow update: if membroSala(sid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reacoes'])
          && request.resource.data.reacoes.diff(resource.data.get('reacoes', {})).affectedKeys().hasOnly([eu()]);
        allow delete: if logado() && (autorAtual() || gmSala(sid));
      }
      // quadro da História: texto, imagem e desenho; cada um mexe no que é seu, o mestre mexe em tudo
      match /quadro/{id} {
        allow read: if membroSala(sid);
        allow create: if membroSala(sid) && autorNovo() && request.resource.data.tipo in ['texto', 'imagem', 'traco'];
        allow update: if membroSala(sid) && (autorAtual() || gmSala(sid))
          && request.resource.data.autor == resource.data.autor && request.resource.data.tipo == resource.data.tipo;
        allow delete: if logado() && (autorAtual() || gmSala(sid));
      }
      match /comentarios/{id} {
        allow read: if membroSala(sid);
        allow create: if membroSala(sid) && autorNovo();
        allow delete: if logado() && (autorAtual() || gmSala(sid));
      }
      match /descobertas/{id} {
        allow read: if membroSala(sid);
        allow create: if membroSala(sid) && autorNovo();
        allow delete: if logado() && (autorAtual() || gmSala(sid));
      }
      match /aceites/{id} {
        allow read: if membroSala(sid);
        allow create, update: if membroSala(sid) && autorNovo() && id == request.resource.data.missao + '_' + eu();
        allow delete: if logado() && (autorAtual() || gmSala(sid));
      }
      // conversa com NPCs: cada player só vê a sua; o mestre vê todas e responde como NPC
      match /conversas/{uid} {
        allow get: if logado() && ((uid == eu() && membroSala(sid)) || gmSala(sid));
        allow list: if gmSala(sid);
        allow write: if logado() && ((uid == eu() && membroSala(sid)) || gmSala(sid));
        match /msgs/{m} {
          allow read: if logado() && ((uid == eu() && membroSala(sid)) || gmSala(sid));
          allow create: if logado() && ((uid == eu() && membroSala(sid) && autorNovo() && request.resource.data.de == 'jogador') || gmSala(sid));
          allow delete: if gmSala(sid);
        }
      }
      // ficha de cada player: ele manda a dele; o mestre lê todas e pode mexer em qualquer uma
      match /fichas/{uid} {
        allow get: if logado() && ((uid == eu() && membroSala(sid)) || gmSala(sid));
        allow list: if gmSala(sid);
        allow write: if logado() && request.resource.data.por == eu()
          && ((uid == eu() && membroSala(sid)) || gmSala(sid));
      }
      // alerta do mestre: aparece na tela de todos da mesa
      match /alertas/{id} {
        allow read: if membroSala(sid);
        allow create: if gmSala(sid) && request.resource.data.autor == eu();
        allow delete: if gmSala(sid);
      }
      // ataque do mestre: o player atacado vê e só pode responder aceitar ou contestar
      match /ataques/{id} {
        allow get: if logado() && ((resource.data.alvo == eu() && membroSala(sid)) || gmSala(sid));
        allow list: if logado() && (gmSala(sid) || (resource.data.alvo == eu() && membroSala(sid)));
        allow create, delete: if gmSala(sid);
        allow update: if gmSala(sid) || (logado() && resource.data.alvo == eu() && membroSala(sid)
          && resource.data.estado == 'pendente' && request.resource.data.estado in ['aceito', 'contestado']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'respTs']));
      }
      // denúncias: o player escreve a dele, só o mestre lê todas
      match /denuncias/{uid} {
        allow get: if logado() && (uid == eu() || gmSala(sid));
        allow list: if gmSala(sid);
        allow write: if logado() && ((uid == eu() && membroSala(sid)) || gmSala(sid));
      }
    }
  }
}
